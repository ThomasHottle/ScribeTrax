@model ScribeTrax.ViewModels.SubmissionViewModel

<h2>Edit Submission</h2>

<form asp-action="Edit">
    @* Hidden ID so MVC can bind *@
    <input type="hidden" asp-for="SubmissionId" />

    <!-- Work dropdown -->
    <div class="form-group">
        <label asp-for="WorkId" class="control-label"></label>
        <select asp-for="WorkId" class="form-control" asp-items="ViewBag.Works"></select>
        <span asp-validation-for="WorkId" class="text-danger"></span>
    </div>

    <!-- Byline dropdown -->
    <div class="form-group">
        <label asp-for="BylineId" class="control-label"></label>
        <select asp-for="BylineId" class="form-control" asp-items="ViewBag.Bylines"></select>
        <span asp-validation-for="BylineId" class="text-danger"></span>
    </div>

    <!-- Market dropdown -->
    <div class="form-group">
        <label asp-for="MarketId" class="control-label"></label>
        <select asp-for="MarketId" class="form-control" asp-items="ViewBag.Markets"></select>
        <span asp-validation-for="MarketId" class="text-danger"></span>
    </div>

    <!-- Submission date -->
    <div class="form-group">
        <label asp-for="SubmissionDate" class="control-label"></label>
        <input asp-for="SubmissionDate" class="form-control" />
        <span asp-validation-for="SubmissionDate" class="text-danger"></span>
    </div>

    <!-- Status dropdown -->
    <div class="form-group">
        <label asp-for="Status" class="control-label"></label>
        <select asp-for="Status" class="form-control" asp-items="ViewBag.Statuses"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <!-- Payment details -->
    <div class="form-group">
        <label asp-for="Fee" class="control-label"></label>
        <input asp-for="Fee" class="form-control" />
        <span asp-validation-for="Fee" class="text-danger"></span>
    </div>

    <div class="form-group form-check">
        <input asp-for="SelfPublished" class="form-check-input" />
        <label asp-for="SelfPublished" class="form-check-label"></label>
    </div>

    <div class="form-group form-check">
        <input asp-for="Royalty" class="form-check-input" />
        <label asp-for="Royalty" class="form-check-label"></label>
    </div>

    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>