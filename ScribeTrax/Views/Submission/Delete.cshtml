@model ScribeTrax.ViewModels.SubmissionViewModel

<h2>Delete Submission</h2>

<div>
    <h4>Are you sure you want to delete this submission?</h4>
    <dl class="row">
        <dt class="col-sm-2">Work</dt>
        <dd class="col-sm-10">@ViewBag.WorkTitle</dd>

        <dt class="col-sm-2">Byline</dt>
        <dd class="col-sm-10">@ViewBag.BylineName</dd>

        <dt class="col-sm-2">Market</dt>
        <dd class="col-sm-10">@ViewBag.MarketName</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">Submission Date</dt>
        <dd class="col-sm-10">@Model.SubmissionDate</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="SubmissionId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>