@model ScribeTrax.ViewModels.WorkViewModel

@{
    ViewData["Title"] = "Delete Work";
}

<h2>Delete Work</h2>

<h4>Are you sure you want to delete this work?</h4>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Title)</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Type)</dt>
        <dd class="col-sm-10">@Model.Type</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.BylineName)</dt>
        <dd class="col-sm-10">@Model.BylineName</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.GenreName)</dt>
        <dd class="col-sm-10">@Model.GenreName</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="WorkId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>