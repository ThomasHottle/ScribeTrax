@model ScribeTrax.ViewModels.BylineUpdateModel

@{
    ViewData["Title"] = "Edit Byline";
}

<h2>Edit Byline</h2>

<form asp-action="Edit" method="post">
    @* Hidden field for the primary key *@
    <input type="hidden" asp-for="BylineId" />

    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Type" class="control-label"></label>
        <select asp-for="Type" class="form-control" asp-items="Model.TypeOptions">
            <option value="">-- Select Role --</option>
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="form-group form-check">
        <input asp-for="IsInactive" class="form-check-input" />
        <label asp-for="IsInactive" class="form-check-label"></label>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
