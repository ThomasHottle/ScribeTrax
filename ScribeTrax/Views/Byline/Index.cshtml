@model IEnumerable<ScribeTrax.ViewModels.BylineViewModel>

<h2>Bylines</h2>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Notes</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var byline in Model)
        {
            <tr>
                <td>@byline.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@byline.BylineId">Details</a>
                    <a asp-action="Edit" asp-route-id="@byline.BylineId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@byline.BylineId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Add New Byline</a>