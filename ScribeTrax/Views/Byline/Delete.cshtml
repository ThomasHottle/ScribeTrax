@model ScribeTrax.ViewModels.BylineUpdateModel

@{
    ViewData["Title"] = "Delete Byline";
}

<h2>Delete Byline</h2>

<h4>Are you sure you want to delete this byline?</h4>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@Model.Type</dd>

        <dt class="col-sm-2">Inactive</dt>
        <dd class="col-sm-10">@Model.IsInactive</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    @* Hidden field for the ID *@
    <input type="hidden" asp-for="BylineId" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>