@model IEnumerable<ScribeTrax.ViewModels.PaymentViewModel>

@{
    ViewData["Title"] = "Payments";
}

<h1>Payments</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Payment</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Work</th>
            <th>Market</th>
            <th>Byline</th>
            <th>Submission Date</th>
            <th>Amount</th>
            <th>Payment Date</th>
            <th>Payment Type</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.WorkTitle</td>
                <td>@item.MarketName</td>
                <td>@item.BylineName</td>
                <td>@item.SubmissionDate</td>
                <td>@item.Amount</td>
                <td>@item.PaymentDate?.ToShortDateString()</td>
                <td>@item.PaymentTypeName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.PaymentId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.PaymentId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.PaymentId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>