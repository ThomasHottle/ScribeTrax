@model ScribeTrax.Models.MarketViewModel

@{
    ViewData["Title"] = "Delete Market";
}

<h2>Delete Market</h2>

<h4>Are you sure you want to delete this market?</h4>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Editor)</dt>
        <dd class="col-sm-10">@Model.Editor</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Type)</dt>
        <dd class="col-sm-10">@Model.Type</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Email)</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Url)</dt>
        <dd class="col-sm-10">@Model.Url</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Postal)</dt>
        <dd class="col-sm-10">@Model.Postal</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="MarketId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>